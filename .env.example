# Copy this file to .env and fill in your own values - .env is gitignored,
# never commit real credentials.
#
# Used by deploy.sh (falls back to these when run with no arguments) and
# tail_logs.py, for testing changes against a real Home Assistant instance
# over SSH before opening a PR.

# SSH connection to the Home Assistant instance.
# Requirements: SSH access reachable as HA_SSH_USER@HA_SSH_HOST (e.g. the
# Terminal & SSH add-on on HAOS), and a /config directory on that host.
HA_SSH_HOST=
HA_SSH_USER=
# Only needed if not the default (22).
HA_SSH_PORT=

# Used by tail_logs.py, via Home Assistant's WebSocket API
# (system_log/list) rather than tailing a log file over SSH - where (or
# whether) Home Assistant writes a log file to disk varies by install
# type (HAOS vs Core vs Container) and by each instance's own logger
# config. Not the REST API's GET /api/error_log - that's still listed in
# Home Assistant's developer docs but has been removed from Core (returns
# a 404 on a real instance).
#
# HA_URL: the base URL Home Assistant itself is reachable at. Optional -
# defaults to https://$HA_SSH_HOST:8123 (HA's own default port, TLS) when
# left blank. Only set this if your instance uses a different URL (plain
# HTTP, a reverse proxy, a non-default port).
# HA_LONG_LIVED_TOKEN: from your HA profile: Settings -> your account ->
# Security -> Long-Lived Access Tokens -> Create Token.
HA_URL=
HA_LONG_LIVED_TOKEN=
